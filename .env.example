# Copy this file to .env on the target machine and fill values there.
# Never commit real credentials, database passwords or payment keys.

POSTGRES_DB=relax
POSTGRES_USER=relax
POSTGRES_PASSWORD=zmien-na-dlugie-losowe-haslo

DJANGO_SECRET_KEY=zmien-na-dlugi-losowy-sekret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=relax-skarpety.com,www.relax-skarpety.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://relax-skarpety.com,https://www.relax-skarpety.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
CHECKOUT_MODE=disabled
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8130

PUBLIC_STOREFRONT_URL=https://relax-skarpety.com
PUBLIC_BACKEND_URL=https://relax-skarpety.com/api
MAIL_FROM=sklep@relax-skarpety.com
