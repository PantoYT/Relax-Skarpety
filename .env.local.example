# Wyłącznie lokalny start na komputerze deweloperskim.
POSTGRES_DB=relax
POSTGRES_USER=relax
POSTGRES_PASSWORD=relax-local-only

DJANGO_SECRET_KEY=local-development-only-change-before-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
CHECKOUT_MODE=test
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

PUBLIC_STOREFRONT_URL=http://localhost:8080
PUBLIC_BACKEND_URL=http://localhost:8080/api
MAIL_FROM=relaxskarpety@interia.pl
